{
  "name": "YueDuo",
  "type": "module",
  "version": "1.1.0",
  "description": "TXT小说阅读与管理器",
  "author": "Joey",
  "homepage": "https://github.com/fmalee/YueDuo",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "dev:web": "vite",
    "build:web": "vite build",
    "dev": "tauri dev",
    "build": "npm run typecheck && tauri build",
    "build:app": "npm run typecheck && tauri build --bundles app",
    "tauri": "tauri"
  },
  "devDependencies": {
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/cli": "^2.12.0",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-vue": "^10.11.1",
    "monaco-editor": "^0.57.0",
    "pinia": "^4.1.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.4",
    "vue": "^3.5.44",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.13"
  }
}
